# Keep the repository normalised to LF (CI runs on Windows runners and
# rustfmt --check must see identical bytes to the developer machine).
* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.geojson text eol=lf
*.yml text eol=lf
# batch files must keep Windows line endings
*.bat text eol=crlf
*.png binary
*.jpg binary
